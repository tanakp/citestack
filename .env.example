# cp .env.example .env
CITESTACK_INDEX_PATH=data/index.sqlite
CITESTACK_DEVICE=cpu
# extractive is an explicitly labeled evidence preview, requiring no LLM server.
CITESTACK_ANSWER_MODE=extractive
CITESTACK_OLLAMA_URL=http://127.0.0.1:11434
CITESTACK_OLLAMA_MODEL=qwen3:4b
# Set a long random value before exposing the API beyond localhost.
# CITESTACK_API_KEY=replace-with-a-long-random-secret
CITESTACK_MAX_CONCURRENT_REQUESTS=2
CITESTACK_MIN_RERANK_SCORE=0
CITESTACK_STRUCTURED_MAX_ATTEMPTS=2
